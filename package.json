{
  "name": "@qeet-id/node",
  "version": "0.1.0",
  "description": "The official server-side Node.js SDK for Qeet ID: manage users, organisations and access, verify webhooks and tokens, and run OAuth flows.",
  "license": "MIT",
  "author": "Qeet Group",
  "homepage": "https://github.com/qeetgroup/qeet-id-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qeetgroup/qeet-id-node.git"
  },
  "bugs": {
    "url": "https://github.com/qeetgroup/qeet-id-node/issues"
  },
  "keywords": [
    "qeet",
    "qeet-id",
    "identity",
    "authentication",
    "authorization",
    "oauth",
    "oidc",
    "saml",
    "scim",
    "webhooks",
    "jwt",
    "sdk"
  ],
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --diagnostic-level=error .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --diagnostic-level=error .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:package": "publint --strict && attw --pack .",
    "verify": "bun run typecheck && bun run check && bun run test && bun run build && bun run check:package",
    "prepublishOnly": "bun run verify"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
