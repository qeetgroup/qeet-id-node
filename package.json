{
  "name": "@qeet-id/node",
  "version": "0.1.0",
  "description": "The official server-side Node.js/TypeScript SDK for Qeet ID — the passkeys-first identity platform.",
  "license": "MIT",
  "author": "Qeet Group",
  "homepage": "https://github.com/qeetgroup/qeet-id-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qeetgroup/qeet-id-node.git"
  },
  "bugs": {
    "url": "https://github.com/qeetgroup/qeet-id-node/issues"
  },
  "keywords": [
    "qeet",
    "identity",
    "auth",
    "authentication",
    "authorization",
    "rbac",
    "rebac",
    "oidc",
    "saml",
    "scim",
    "sdk"
  ],
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=18.17"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.5"
  }
}
