{
  "name": "@qeet-id/node",
  "version": "0.1.0",
  "description": "The official server-side Node.js/TypeScript SDK for Qeet ID — the passkeys-first identity platform.",
  "license": "MIT",
  "author": "Qeet Group",
  "homepage": "https://github.com/qeetgroup/qeet-id-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qeetgroup/qeet-id-node.git"
  },
  "bugs": {
    "url": "https://github.com/qeetgroup/qeet-id-node/issues"
  },
  "keywords": [
    "qeet",
    "identity",
    "auth",
    "authentication",
    "authorization",
    "rbac",
    "rebac",
    "oidc",
    "saml",
    "scim",
    "sdk"
  ],
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --diagnostic-level=error .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "biome check --diagnostic-level=error .",
    "prepublishOnly": "bun run verify",
    "verify": "bun run typecheck && bun run check && bun run test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
